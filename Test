<script>
/* --- 1. Reveal au scroll --- */
(function(){
  const els=document.querySelectorAll('.reveal');
  if(!('IntersectionObserver' in window)){els.forEach(e=>e.classList.add('vu'));return}
  const io=new IntersectionObserver((ents)=>{
    ents.forEach((e,i)=>{
      if(e.isIntersecting){
        setTimeout(()=>e.target.classList.add('vu'),i*70);
        io.unobserve(e.target);
      }
    });
  },{threshold:.12,rootMargin:'0px 0px -8% 0px'});
  els.forEach(e=>io.observe(e));
})();

/* --- 2. Filtre des missions par rythme --- */
(function(){
  const btns=document.querySelectorAll('.filtre');
  const cards=document.querySelectorAll('.mission');
  const vide=document.getElementById('vide');
  btns.forEach(b=>{
    b.addEventListener('click',()=>{
      btns.forEach(x=>x.classList.remove('actif'));
      b.classList.add('actif');
      const f=b.dataset.f;
      let n=0;
      cards.forEach(c=>{
        const ok = f==='tout' || c.dataset.rythmes.includes(f);
        c.classList.toggle('masque',!ok);
        if(ok) n++;
      });
      vide.classList.toggle('visible',n===0);
    });
  });
})();

/* --- 3. FAQ accordéon --- */
(function(){
  document.querySelectorAll('.faq-q').forEach(q=>{
    q.addEventListener('click',()=>{
      const item=q.parentElement;
      const rep=item.querySelector('.faq-r');
      const ouvert=item.classList.toggle('ouvert');
      q.setAttribute('aria-expanded',ouvert);
      rep.style.maxHeight = ouvert ? rep.scrollHeight+'px' : '0';
    });
  });
})();

/* --- 4. Barre sticky après le hero --- */
(function(){
  const barre=document.getElementById('barre');
  const hero=document.querySelector('.hero');
  const io=new IntersectionObserver((e)=>{
    barre.classList.toggle('visible',!e[0].isIntersecting);
  },{threshold:0});
  io.observe(hero);
})();
</script>
